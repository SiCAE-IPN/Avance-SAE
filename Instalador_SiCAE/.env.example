# =====================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO - PROYECTO SiCAE (IPN)
# =====================================================================

# --- 1. CONFIGURACIÓN DE BASE DE DATOS (SQL SERVER) ---
DB_USER=tu_usuario_sql
DB_PASSWORD=tu_contraseña_sql
DB_HOST=tu_servidor_o_ip_sql
DB_PORT=1433
DB_NAME=nombre_de_tu_base_de_datos
DB_DRIVER=ODBC Driver 17 for SQL Server

# --- 2. CONFIGURACIÓN DE CORREO INSTITUCIONAL (MICROSOFT GRAPH / EXCHANGE) ---
MICROSOFT_CLIENT_ID=tu_client_id_de_entra_id
MICROSOFT_TENANT_ID=tu_tenant_id_de_entra_id
MICROSOFT_CLIENT_SECRET=tu_client_secret_de_entra_id
SMTP_FROM=sicae@ipn.mx
SMTP_SUBJECT_PREFIX=SiCAE
